# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# ---------------------------------------------------------------------------
# Cassette Player safety block
# ---------------------------------------------------------------------------

# Generated platform folders (created in CI by tool/bootstrap_platforms.sh)
/android/
/ios/

# Signing secrets: never commit these
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision
*.cer
secrets.*

# Local machine config
android/local.properties
.idea/
.vscode/
.DS_Store

# Build outputs
*.apk
*.aab
*.ipa

# Audio and test data (your music stays on your device, not in git)
*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.opus
*.db
*.sqlite
ci-logs/
